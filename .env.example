TVPN_DATABASE_URL=postgres://tvpn:change-me@localhost:5432/tvpn?sslmode=disable
TVPN_LISTEN_ADDRESS=:8080
TVPN_APP_ORIGIN=http://app.localhost:8080
TVPN_PROXY_BASE_DOMAIN=proxy.localhost:8080
TVPN_ENV=development
TVPN_BOOTSTRAP_ADMIN_USERNAME=admin
TVPN_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/tvpn_bootstrap_password
TVPN_LDAP_BIND_PASSWORD_FILE=/run/secrets/tvpn_ldap_bind_password
TVPN_LDAP_CA_FILE=/run/secrets/tvpn_ldap_ca.pem
TVPN_LDAP_ALLOW_INSECURE=false
