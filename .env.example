# Public deployment example. Copy to .env and replace every example value.
TVPN_ENV=production
TVPN_BIND_ADDRESS=127.0.0.1
TVPN_PORT=18080

# Multi-architecture images mirrored to Alibaba Cloud Container Registry.
TVPN_APP_IMAGE=registry.cn-hangzhou.aliyuncs.com/fjrcn/tvpn:latest
TVPN_POSTGRES_IMAGE=registry.cn-hangzhou.aliyuncs.com/fjrcn/tvpn-pg:17-alpine

# The management Origin includes the scheme. The proxy domain has no scheme.
TVPN_APP_ORIGIN=https://vpn.example.com
TVPN_PROXY_BASE_DOMAIN=proxy.vpn.example.com

# Use URL-safe characters because this value is interpolated into the default URL.
TVPN_POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

# Set these to the owner of files under ./secrets on the deployment host.
TVPN_CONTAINER_UID=1000
TVPN_CONTAINER_GID=1000

# Optional: override when using an external PostgreSQL service.
# TVPN_DATABASE_URL=postgres://tvpn:password@database.example.com:5432/tvpn?sslmode=require
